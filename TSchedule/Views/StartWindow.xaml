<Window x:Class="TSchedule.Views.StartWindow"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Width="400"
        Height="500"
        Title="Приветствие"
        Background="#0000"
        ResizeMode="NoResize"
        ui:TitleBar.Height="60"
        ui:WindowHelper.ApplyNoise="False"
        ui:WindowHelper.CornerStyle="Round"
        WindowStartupLocation="CenterScreen"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.CloseButtonAvailability="Enabled"
        ui:WindowHelper.SystemBackdropType="Acrylic10"
        ui:TitleBar.MaximizeButtonAvailability="Collapsed"
        Foreground="{DynamicResource SystemControlBackgroundBaseHighBrush}"
        ui:WindowHelper.Acrylic10Color="{DynamicResource SystemChromeLowColor}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              x:Name="TitleBar"
              Background="{DynamicResource SystemControlBackgroundAccentBrush}">

            <StackPanel Margin="20,0"
                        Panel.ZIndex="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        ui:PanelHelper.Spacing="2">

                <TextBlock Text="TS"
                           FontSize="36"/>

                <TextBlock FontSize="36"
                           Text="chedule"/>

            </StackPanel>

            <Rectangle Width="40"
                       Height="40"
                       Margin="18,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Fill="{DynamicResource SystemControlBackgroundAltHighBrush}"/>

        </Grid>

        <ui:Frame Padding="20"
		          Grid.Row="1"
		          x:Name="NavigationFrame"/>

    </Grid>
</Window>
