<Window x:Class="TSchedule.Views.StartWindowWin7"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Width="400"
        Height="500"
        Title="Приветствие"
        ResizeMode="NoResize"
        ui:TitleBar.Height="60"
        WindowStartupLocation="CenterScreen"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.MaximizeButtonAvailability="Collapsed"
        Foreground="{DynamicResource SystemControlBackgroundBaseHighBrush}">

    <Border Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  x:Name="TitleBar"
                  Background="{DynamicResource SystemControlBackgroundAccentBrush}">
                  <!--Background="#FF5D4ABC">-->

                <StackPanel Margin="20,0"
                            Panel.ZIndex="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            ui:PanelHelper.Spacing="2">
                    
                    <TextBlock Text="TS"
                               FontSize="36"/>
                    
                    <TextBlock FontSize="36"
                               Text="chedule"/>
                    
                </StackPanel>

                <Rectangle Width="40"
                           Height="40"
                           Margin="18,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Fill="{DynamicResource SystemControlBackgroundAltHighBrush}" />

            </Grid>

            <ui:Frame Padding="20"
		              Grid.Row="1"
		              x:Name="NavigationFrame"/>

        </Grid>

    </Border>

</Window>
