<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.ClassroomsPage"
         xmlns:c="clr-namespace:TSchedule.Converters"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         Title="Аудитории"
         d:DesignWidth="800"
         Loaded="Page_Loaded"
         d:Background="White"
         d:DesignHeight="450">
    
    <ui:Page.Resources>
        <c:ValueToOpacityConverter x:Key="ValueToOpacityConverter"/>
        <c:NullableToBooleanConverter x:Key="NullableToBooleanConverter"/>
        <c:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ui:Page.Resources>

    <Grid Margin="20"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">

        <ui:ListView Padding="4"
                     Grid.Column="0"
                     x:Name="ClassroomList"
                     SelectionMode="Single"
                     ItemsSource="{Binding Classrooms}">
            <!--     IsSelectionEnabled="False"
                     IsItemClickEnabled="False" -->
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4"
                            CornerRadius="8"
                            BorderThickness="1">
                        <Grid Margin="8">
                            <StackPanel Margin="20,0"
                                        ui:PanelHelper.Spacing="4">
                                <TextBlock FontSize="16"
                                           FontWeight="Bold"
                                           Text="{Binding Number}"/>
                                <TextBlock FontSize="12"
                                           Text="{Binding Type}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</ui:Page>
