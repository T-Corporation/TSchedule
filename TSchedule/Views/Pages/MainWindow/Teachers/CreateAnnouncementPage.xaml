<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.Teachers.CreateAnnouncementPage"
         xmlns:c="clr-namespace:TSchedule.Converters"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
         mc:Ignorable="d"
         d:DesignWidth="800"
         Loaded="Page_Loaded"
         d:DesignHeight="450"
         Title="Создание уведомлений">
    
    <ui:Page.Resources>
        <c:BoolToMessageConverter x:Key="BoolToMessageConverter"/>
        <c:ValueToOpacityConverter x:Key="ValueToOpacityConverter"/>
        <c:StringToInitialsConverter x:Key="StringToInitialsConverter"/>
        <c:NullableToBooleanConverter x:Key="NullableToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <c:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ui:Page.Resources>

    <Grid Margin="20"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
    
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <ui:FlyoutBase.AttachedFlyout>
            <ui:Flyout x:Name="AnnouncementFlyout">
                <Border Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <ScrollViewer ui:ScrollViewerBehavior.IsAnimating="True">
                                <StackPanel ui:PanelHelper.Spacing="16">
                                    <TextBox Width="360"
                                             Text="{Binding Reason}"
                                             ui:ControlHelper.Header="Причина"
                                             ui:ControlHelper.CornerRadius="8"
                                             ui:ControlHelper.PlaceholderText="Я заболел"
                                             ui:TextBoxHelper.IsDeleteButtonVisible="True"
                                             ui:TextContextMenu.UsingTextContextMenu="True"
                                             ToolTipService.ToolTip="Введите причину отсутствия"/>
                                    <DatePicker Width="350"
                                                IsTodayHighlighted="True"
                                                ui:ControlHelper.CornerRadius="8"
                                                ui:ControlHelper.Header="Дата начала отсутствия"
                                                SelectedDate="{Binding AbsentFromDate, Mode=TwoWay}"
                                                ToolTipService.ToolTip="Выберите дату начала отсутствия в формате: ДД.ММ.ГГГГ"/>
                                    <ui:TimePicker Culture="ru"
                                                    Padding="0,0,12,0"
                                                    HourPlaceholderText="Час"
                                                    HorizontalAlignment="Stretch"
                                                    MinutePlaceholderText="Минута"
                                                    ui:ControlHelper.Header="Начало"
                                                    ui:ControlHelper.CornerRadius="8"
                                                    SelectedDateTime="{Binding AbsentFromTime, Mode=TwoWay}"
                                                    ToolTipService.ToolTip="Выберите время начала отсутствия."/>
                                    <DatePicker Width="350"
                                                IsTodayHighlighted="True"
                                                ui:ControlHelper.CornerRadius="8"
                                                SelectedDate="{Binding AbsentToDate, Mode=TwoWay}"
                                                ui:ControlHelper.Header="Дата окончания отсутствия"
                                                ToolTipService.ToolTip="Выберите дату окончания отсутствия в формате: ДД.ММ.ГГГГ"/>
                                    <ui:TimePicker Culture="ru"
                                                   Padding="0,0,12,0"
                                                   HourPlaceholderText="Час"
                                                   HorizontalAlignment="Stretch"
                                                   MinutePlaceholderText="Минута"
                                                   ui:ControlHelper.Header="Начало"
                                                   ui:ControlHelper.CornerRadius="8"
                                                   SelectedDateTime="{Binding AbsentToTime, Mode=TwoWay}"
                                                   ToolTipService.ToolTip="Выберите время окончания отсутствия."/>
                                    <TextBlock MaxWidth="360"
                                               TextWrapping="Wrap"
                                               Foreground="#CC3300"
                                               TextAlignment="Center"
                                               Text="{Binding ErrorMessage}"
                                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Margin="0,16,0,0"
                                    ui:PanelHelper.Spacing="8">
                            <Button Cursor="Hand"
                                    Content="Сохранить"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding AddOrEditCommand}"
                                    Style="{StaticResource AccentButtonStyle}"/>
                            <Button Cursor="Hand"
                                    Content="Отмена"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding HideFlyoutCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </ui:Flyout>
        </ui:FlyoutBase.AttachedFlyout>

        <ui:ListView Padding="4"
                     Grid.Column="0"
                     x:Name="TeacherList"
                     SelectionMode="Single"
                     ItemsSource="{Binding Announcements}"
                     SelectedItem="{Binding Announcement}">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4"
                            CornerRadius="8"
                            BorderThickness="1">                        
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            
                            <CheckBox Grid.Column="0"
                                      IsEnabled="False"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left"
                                      IsChecked="{Binding IsRegistered}"
                                      ToolTipService.HasDropShadow="True"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTipService.ToolTip="{Binding IsRegistered, Converter={StaticResource BoolToMessageConverter}, ConverterParameter='Зарегистрировано;Не зарегистрировано'}"/>
                            
                            <StackPanel Margin="20,0"
                                        Grid.Column="1"
                                        ui:PanelHelper.Spacing="8">

                                <TextBlock Padding="4"
                                           Text="{Binding Reason, StringFormat='Причина: &quot;{0}&quot;'}"/>

                                <StackPanel Orientation="Horizontal">
                                    
                                    <TextBlock FontSize="16"
                                               Padding="4"
                                               Text="{Binding AbsentFrom, StringFormat='С {0:dd.MM.yyyy HH:mm} до'}"/>
                                    
                                    <TextBlock FontSize="16"
                                               Padding="4"
                                               Text="{Binding AbsentTo, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                    
                                </StackPanel>

                                <TextBlock FontSize="12"
                                           Padding="4"
                                           Text="{Binding CreatedAt, StringFormat='Создано: {0:dd.MM.yyyy HH:mm}'}"/>

                                <TextBlock FontSize="12"
                                           Padding="4"
                                           Text="{Binding UpdatedAt, StringFormat='Обновлено: {0:dd.MM.yyyy HH:mm}'}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>

        <StackPanel Margin="8"
                    Grid.Column="1"
                    ui:PanelHelper.Spacing="8"
                    HorizontalAlignment="Stretch">

            <Button Cursor="Hand"
                    x:Name="AddButton"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ShowFlyoutCommand}"
                    Style="{DynamicResource AccentButtonStyle}">

                <ui:IconAndText Padding="8"
                                Content="Добавить"
                                Icon="{x:Static ui:SegoeFluentIcons.Add}"/>

            </Button>

            <Button Cursor="Hand"
                    x:Name="EditButton"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ShowEditFlyoutCommand}">
                <ui:IconAndText Content="Изменить"
                                Icon="{x:Static ui:SegoeFluentIcons.Edit}"/>
            </Button>

            <Button x:Name="DeleteButton"
                    Foreground="#CC3360"
                    HorizontalAlignment="Stretch"
                    Command="{Binding DeleteCommand}">
                <ui:IconAndText Content="Удалить"
                                Icon="{x:Static ui:SegoeFluentIcons.Delete}"/>
            </Button>

        </StackPanel>

    </Grid>
    
</ui:Page>
