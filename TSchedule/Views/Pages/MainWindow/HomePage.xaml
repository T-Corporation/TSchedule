<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.HomePage"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         Title="Главная"
         mc:Ignorable="d"
         d:DesignWidth="800"
         Loaded="Page_Loaded"
         d:Background="White"
         d:DesignHeight="560">

    <ui:Page.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.HasDropShadow" Value="True"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </ui:Page.Resources>

    <ScrollViewer VerticalAlignment="Stretch">

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="20"
                        Grid.Row="0"
                        VerticalAlignment="Center">

                <TextBlock FontSize="18"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Text="{Binding FullName, StringFormat='Добро пожаловать, {0}!'}"/>

                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Text="Вот с чего можно начать:"/>

            </StackPanel>

            <Grid Grid.Row="1"
                  VerticalAlignment="Center"
                  ui:PanelHelper.Spacing="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Уведомления -->
                <StackPanel Grid.Column="0"
                            ui:PanelHelper.Spacing="16">
                    
                    <Viewbox MinWidth="40"
                             MaxWidth="200">
                             
                        <Image Stretch="Uniform"
                               Source="/Images/bell_375.png"/>
                        
                    </Viewbox>
                    
                    <TextBlock Text="Следите за уведомлениями преподавателей, чтобы быть в курсе всех последних новостей."/>
                    
                    <Button Command="{Binding GoToAnnouncementsCommand}"
                            ToolTipService.ToolTip="Нажмите, чтобы перейти к уведомлениям">
                        <TextBlock TextWrapping="NoWrap"
                                   Text="Открыть уведомления"
                                   TextTrimming="CharacterEllipsis"/>
                    </Button>
                    
                </StackPanel>

                <!-- Просмотр расписания -->
                <StackPanel Grid.Column="1"
                            ui:PanelHelper.Spacing="16">
                    
                    <Viewbox MinWidth="40"
                             MaxWidth="200">
                        
                        <Image Stretch="Uniform"
                               Source="/Images/clock_375.png"/>
                        
                    </Viewbox>
                    
                    <TextBlock Text="Получите доступ к актуальному расписанию занятий, чтобы всегда знать, когда и где пройдут ваши занятия."/>
                    
                    <Button Command="{Binding GoToScheduleCommand}"
                            ToolTipService.ToolTip="Нажмите, чтобы открыть актуальное расписание">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Открыть расписание"
                                   TextTrimming="CharacterEllipsis"/>
                    </Button>
                    
                </StackPanel>

                <!-- Аудитории -->
                <StackPanel Grid.Column="2"
                            ui:PanelHelper.Spacing="16">
                    
                    <Viewbox MinWidth="40"
                             MaxWidth="200">
                        
                        <Image Stretch="UniformToFill"
                               Source="/Images/classroom_375.png"/>
                        
                    </Viewbox>
                    
                    <TextBlock Text="Найдите информацию о доступных аудиториях."/>
                    
                    <!-- ReSharper disable once Xaml.BindingWithoutContextNotResolved -->
                    <Button Command="{Binding GoToClassroomsCommand}"
                            ToolTipService.ToolTip="Нажмите для просмотра всех аудиторий">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Посмотреть аудитории"
                                   TextTrimming="CharacterEllipsis"/>
                    </Button>

                </StackPanel>
                
            </Grid>

            <Button Content="?"
                    Margin="0"
                    Grid.Row="2"
                    FontSize="24"
                    Padding="14,4"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Command="{Binding GoToHelpCommand}"/>

        </Grid>

    </ScrollViewer>

</ui:Page>
