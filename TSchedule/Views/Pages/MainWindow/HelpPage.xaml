<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.HelpPage"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:vm="clr-namespace:TSchedule.ViewModels.Pages.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         FontSize="18"
         mc:Ignorable="d"
         Title="Поддержка"
         d:DesignWidth="640"
         d:Background="White"
         d:DesignHeight="480">
    
    <ui:Page.DataContext>
        <vm:HelpViewModel/>
    </ui:Page.DataContext>

    <ScrollViewer>
        <GroupBox Margin="8">
            <GroupBox.Header>
                <TextBlock Text="Администратору"
                           FontSize="24"/>
            </GroupBox.Header>
            <StackPanel ui:PanelHelper.Spacing="16">
                <TextBlock TextWrapping="Wrap"
                           Text="Проблемы с импортом? Попробуйте сделать своё расписание по предложенному шаблону"/>
                <Button Padding="8"
                        Cursor="Hand"
                        CommandParameter="xlsx"
                        HorizontalAlignment="Stretch"
                        Command="{Binding DownloadCommand}"
                        Content="Скачать шаблон расписания (xlsx)"
                        Style="{DynamicResource AccentButtonStyle}"/>
                <Button Padding="8"
                        Cursor="Hand"
                        CommandParameter="xls"
                        HorizontalAlignment="Stretch"
                        Command="{Binding DownloadCommand}"
                        Content="Скачать шаблон расписания (xls)"/>
            </StackPanel>
        </GroupBox>
    </ScrollViewer>
</ui:Page>
