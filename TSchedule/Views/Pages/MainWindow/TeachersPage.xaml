<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.TeachersPage"
         xmlns:c="clr-namespace:TSchedule.Converters"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
         mc:Ignorable="d"
         d:DesignWidth="800"
         Title="TeachersPage"
         Loaded="Page_Loaded"
         d:Background="White"
         d:DesignHeight="450">

    <ui:Page.Resources>
        <c:ValueToOpacityConverter x:Key="ValueToOpacityConverter"/>
        <c:StringToInitialsConverter x:Key="StringToInitialsConverter"/>
        <c:NullableToBooleanConverter x:Key="NullableToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <c:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ui:Page.Resources>

    <Grid Margin="20">

        <ui:ListView Padding="4"
                     Grid.Column="0"
                     x:Name="TeacherList"
                     SelectionMode="Single"
                     ItemsSource="{Binding Teachers}">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4"
                            CornerRadius="8"
                            BorderThickness="1">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- Teacher Icon or Placeholder -->
                            <ui:PersonPicture Width="96"
                                              Height="96"
                                              HorizontalAlignment="Left"
                                              Initials="{Binding FullName, Converter={StaticResource StringToInitialsConverter}}"/>

                            <!-- Teacher Information -->
                            <StackPanel Margin="20,0"
                                        Grid.Column="1">
                        
                                <!-- Full Name -->
                                <TextBox FontSize="16"
                                         Padding="4,0"
                                         Cursor="Arrow"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalAlignment="Left"
                                         Text="{Binding FullName}"/>

                                <!-- Classroom -->
                                <TextBox FontSize="12"
                                         Padding="4,0"
                                         Cursor="Arrow"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalAlignment="Left"
                                         Text="{Binding Classroom.Number, StringFormat='Аудитория {0}'}"/>

                                <!-- Subject -->
                                <TextBox FontSize="12"
                                         Padding="4,0"
                                         Cursor="Arrow"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalAlignment="Left"
                                         Text="{Binding Subject.Name}"/>

                                <!-- Username -->
                                <TextBox FontSize="12"
                                         Padding="4,0"
                                         Cursor="Arrow"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalAlignment="Left"
                                         Text="{Binding UserName, StringFormat='Логин: {0}'}"/>

                                <!-- Email with conditional visibility -->
                                <TextBox FontSize="12"
                                         Padding="4,0"
                                         Cursor="Arrow"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalAlignment="Left"
                                         Text="{Binding Email, TargetNullValue='Почта не указана'}" 
                                         Opacity="{Binding Email, Converter={StaticResource ValueToOpacityConverter}, ConverterParameter=.7}"/>

                                <!-- Phone Number with conditional visibility -->
                                <TextBox FontSize="12"
                                         Padding="4,0"
                                         Cursor="Arrow"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalAlignment="Left"
                                         Text="{Binding PhoneNumber, TargetNullValue='Телефон не указан'}" 
                                         Opacity="{Binding PhoneNumber, Converter={StaticResource ValueToOpacityConverter}, ConverterParameter=.7}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    
    </Grid>
    
</ui:Page>
