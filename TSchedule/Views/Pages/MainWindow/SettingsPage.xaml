<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.SettingsPage"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:vm="clr-namespace:TSchedule.ViewModels.Pages.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         Title="Параметры"
         d:DesignWidth="900"
         Loaded="Page_Loaded"
         d:Background="White"
         d:DesignHeight="650">
    
    <ui:Page.Resources>
        <CollectionViewSource x:Key="GroupedSoundtracks"
                              Source="{Binding Tracks}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Catalog"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </ui:Page.Resources>
    
    <ui:Page.DataContext>
        <vm:SettingsViewModel/>
    </ui:Page.DataContext>

    <Grid>
        <ui:ContentDialog d:Panel.ZIndex="1"
                          x:Name="ResetDialog"
                          CloseButtonText="Позже"
                          d:Visibility="Collapsed"
                          TextBlock.TextAlignment="Justify"
                          PrimaryButtonText="Перезагрузить сейчас"
                          PrimaryButtonStyle="{DynamicResource AccentButtonStyle}"
                          PrimaryButtonCommand="{Binding RebootApplicationCommand}"
                          CloseButtonCommand="{Binding AlterModernUIEnabledCommand}"
                          Content="Рекомендуется перезапустить приложение&#x0a;для смены текущего интерфейса."/>

        <ScrollViewer x:Name="ScrollViewer"
                      IsDeferredScrollingEnabled="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <Grid Margin="20,20,40,20">
                <StackPanel ui:PanelHelper.Spacing="12">
                    <ComboBox Padding="8"
                              HorizontalAlignment="Stretch"
                              ui:ControlHelper.Header="Тема приложения"
                              ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding Theme, Mode=TwoWay}"
                              ui:ControlHelper.PlaceholderText="Выберите тему"/>
                    <ui:ToggleSwitch OnContent="Вкл"
                                     OffContent="Выкл"
                                     Header="Современный интерфейс*"
                                     IsOn="{Binding IsModernUIEnabled, Mode=TwoWay}"
                                     ToolTipService.ToolTip="Может потребоваться перезагрузка приложения"/>
                    <ComboBox Padding="8"
                              HorizontalAlignment="Stretch"
                              ui:ControlHelper.Header="Шрифт"
                              IsSynchronizedWithCurrentItem="True"
                              SelectedItem="{Binding FontFamily, Mode=TwoWay}"
                              ui:ControlHelper.PlaceholderText="Выберите шрифт"
                              ItemsSource="{Binding FontFamilies, Mode=OneTime}"/>
                    <ComboBox Padding="8"
                              HorizontalAlignment="Stretch"
                              IsSynchronizedWithCurrentItem="True"
                              ui:ControlHelper.Header="Размер шрифта"
                              SelectedItem="{Binding FontSize, Mode=TwoWay}"
                              ItemsSource="{Binding FontSizes, Mode=OneTime}"
                              ui:ControlHelper.PlaceholderText="Выберите размер шрифта"/>
                    <Button Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            ui:ControlHelper.Header="Подключение"
                            Command="{Binding SetConnectionCommand}"
                            ToolTipService.ToolTip="Нажмите, чтобы добавить свою строку подключения.">
                        <ui:IconAndText Content="Настроить подключение"
                                        Icon="{x:Static ui:SegoeFluentIcons.Connect}"/>
                    </Button>
                    <Button Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{DynamicResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Нажмите, чтобы сохранить выбранные параметры.">
                        <ui:IconAndText Content="Сохранить"
                                        Icon="{x:Static ui:SegoeFluentIcons.Save}"/>
                    </Button>
                    <Button Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ResetSettingsCommand}"
                            ToolTipService.ToolTip="Нажмите, чтобы сбросить свои параметры до заводских настроек.">
                        <ui:IconAndText Content="Сбросить до заводских настроек"
                                        Icon="{x:Static ui:SegoeFluentIcons.ResetDrive}"/>
                    </Button>
                    
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    ui:PanelHelper.Spacing="8">
                            <TextBlock Text="Фоновая музыка"
                                       VerticalAlignment="Center"/>
                            <ui:DropDownButton Padding="4"
                                               Cursor="Help"
                                               ShowChevronArrow="False">
                                <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.StatusCircleQuestionMark}"/>
                                <ui:DropDownButton.Flyout>
                                    <ui:Flyout>
                                        <TextBlock MaxWidth="240"
                                                   TextWrapping="Wrap">
                                            Чтобы добавить свои саундтреки нужно:
                                            <LineBreak/>
                                            <LineBreak/>
                                            1. Открыть папку с приложением
                                            <LineBreak/>
                                            <LineBreak/>
                                            2. Найти и открыть папку <Bold FontWeight="SemiBold">Music</Bold>
                                            <LineBreak/>
                                            <LineBreak/>
                                            3. Добавить туда необходимые папки и внутри них добавить музыкальные файлы
                                            <LineBreak/>
                                            <LineBreak/>
                                            <Bold FontStyle="Italic" FontWeight="Regular">Названия папок могут содержать: кириллицу, латиницу, цифры, пробелы и знаки подчеркивания (только в середине, например: Название_папки - верно, _Название_папки - неверно)</Bold>
                                            <Bold FontStyle="Italic" FontWeight="Regular">Поддерживаются только файлы с расширением .wav</Bold>
                                        </TextBlock>
                                    </ui:Flyout>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>
                        </StackPanel>
                        
                        <ui:ListView IsItemClickEnabled="True"
                                     IsSelectionEnabled="True"
                                     ScrollViewer.CanContentScroll="False"
                                     PreviewMouseWheel="ListView_PreviewMouseWheel"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectedItem="{Binding SelectedTrack}"
                                     ItemsSource="{Binding Source={StaticResource GroupedSoundtracks}}">
                            <ui:ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                            <TextBlock TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ui:ListView.GroupStyle>
                            
                            <ui:ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis"
                                               Text="{Binding Name}"
                                               ToolTipService.ToolTip="{Binding Name}"/>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>
                    </StackPanel>

                    <Grid ui:PanelHelper.Spacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Cursor="Hand"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding PlaySelectedTrackCommand}"
                                ToolTipService.ToolTip="Нажмите, чтобы воспроизвести саундтрек">
                            <ui:IconAndText Content="Играть"
                                            Icon="{x:Static ui:SegoeFluentIcons.Play}"/>
                        </Button>
                        <Button Cursor="Hand"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Command="{Binding StopCommand}"
                                ToolTipService.ToolTip="Нажмите, чтобы остановить саундтрек">
                            <ui:IconAndText Content="Стоп"
                                            Icon="{x:Static ui:SegoeFluentIcons.Stop}"/>
                        </Button>
                        <ui:ToggleSwitch Grid.Column="2"
                                         OnContent="На повторе"
                                         OffContent="Без повтора"
                                         IsOn="{Binding Loop}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:Page>
