<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.Administrators.GroupSelectionPage"
         xmlns:c="clr-namespace:TSchedule.Converters"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         d:DesignWidth="800"
         Title="Выбор группы"
         Loaded="Page_Loaded"
         d:Background="White"
         d:DesignHeight="450"
         WindowTitle="Выбор группы">
    
    <ui:Page.Resources>
        <c:NullableToBooleanConverter x:Key="NullableToBooleanConverter"/>
    </ui:Page.Resources>

    <Grid>
        <ui:ContentDialog IsShadowEnabled="True"
                          PrimaryButtonText="ОК"
                          CloseButtonText="Отмена"
                          x:Name="GroupSelectionDialog"
                          Title="Выберите группу студентов"
                          CloseButtonCommand="{Binding GoBackCommand}"
                          PrimaryButtonCommand="{Binding CloseDialogCommand}"
                          IsPrimaryButtonEnabled="{Binding SelectedGroup, Converter={StaticResource NullableToBooleanConverter}}">
            <ComboBox ItemsSource="{Binding Groups}"
                      IsSynchronizedWithCurrentItem="True"
                      ui:ControlHelper.Header="Группа студентов"
                      ui:ControlHelper.PlaceholderText="Выберите группу"
                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"/>
        </ui:ContentDialog>
    </Grid>
</ui:Page>
