<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.Administrators.RegisterAnnouncementsPage"
         xmlns:c="clr-namespace:TSchedule.Converters"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d" 
         d:DesignWidth="800"
         Loaded="Page_Loaded"
         d:DesignHeight="450"
         Title="Регистрация уведомлений">

    <ui:Page.Resources>
        <c:BoolToMessageConverter x:Key="BoolToMessageConverter"/>
        <c:ValueToOpacityConverter x:Key="ValueToOpacityConverter"/>
        <c:StringToInitialsConverter x:Key="StringToInitialsConverter"/>
        <c:NullableToBooleanConverter x:Key="NullableToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <c:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ui:Page.Resources>

    <Grid Margin="20" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

        <!-- Список уведомлений с активным чекбоксом -->
        <ui:ListView Padding="4"
                     IsSelectionEnabled="False"
                     IsItemClickEnabled="False"
                     x:Name="RegisteredAnnouncementsList"
                     ItemsSource="{Binding Announcements}">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4" CornerRadius="8" BorderThickness="1">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left"
                                      CommandParameter="{Binding}"
                                      IsChecked="{Binding IsRegistered, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Command="{Binding DataContext.UpdateRegistrationCommand, RelativeSource={RelativeSource AncestorType=ui:Page}}"/>

                            <StackPanel Margin="20,0"
                                        Grid.Column="1"
                                        ui:PanelHelper.Spacing="8">
                                <TextBlock Padding="4"
                                           Text="{Binding Reason, StringFormat='Причина: &quot;{0}&quot;'}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16"
                                               Padding="4"
                                               Text="{Binding AbsentFrom, StringFormat='С {0:dd.MM.yyyy HH:mm} до'}"/>
                                    <TextBlock FontSize="16"
                                               Padding="4"
                                               Text="{Binding AbsentTo, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                </StackPanel>
                                <TextBlock FontSize="12"
                                           Padding="4,0"
                                           Text="{Binding CreatedAt, StringFormat='Создано: {0:dd.MM.yyyy HH:mm}'}"/>
                                <TextBlock FontSize="12"
                                           Padding="4,0"
                                           Text="{Binding UpdatedAt, StringFormat='Обновлено: {0:dd.MM.yyyy HH:mm}'}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</ui:Page>
