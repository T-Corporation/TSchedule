<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.Administrators.ScheduleManagementPage"
         xmlns:c="clr-namespace:TSchedule.Converters"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         d:DesignWidth="800"
         Loaded="Page_Loaded"
         d:Background="White"
         d:DesignHeight="450"
         Title="Управление расписанием">
    
    <ui:Page.Resources>
        <c:ValueToOpacityConverter x:Key="ValueToOpacityConverter"/>
        <c:NullableToBooleanConverter x:Key="NullableToBooleanConverter"/>
        <c:EmptyToPlaceholderConverter x:Key="EmptyToPlaceholderConverter"/>
        <c:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ui:Page.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <TabControl x:Name="TabControl"
                        ui:TabControlHelper.IsAddTabButtonVisible="False"
                        ui:TabControlHelper.ContentBackground="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
                <!-- Вкладка для числителя -->
                <TabItem IsSelected="True"
                         Header="Числитель"
                         x:Name="NumeratorTab">
                    <DataGrid IsReadOnly="True"
                              SelectionUnit="Cell"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              AutoGenerateColumns="False"
                              PreviewKeyDown="DataGrid_PreviewKeyDown"
                              ItemsSource="{Binding NumeratorDailySchedule}"
                              ui:DataGridHelper.UseModernColumnStyles="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Selector.IsSelected="False" Header="Урок" Binding="{Binding Lesson.Id}"/>
                            <DataGridTextColumn Header="Понедельник" Binding="{Binding Monday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                            <DataGridTextColumn Header="Вторник" Binding="{Binding Tuesday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                            <DataGridTextColumn Header="Среда" Binding="{Binding Wednesday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                            <DataGridTextColumn Header="Четверг" Binding="{Binding Thursday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                            <DataGridTextColumn Header="Пятница" Binding="{Binding Friday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                            <DataGridTextColumn Header="Суббота" Binding="{Binding Saturday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                            <DataGridTextColumn Header="Воскресенье" Binding="{Binding Sunday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Вкладка для знаменателя -->
                <TabItem Header="Знаменатель"
                         x:Name="DenominatorTab">
                    <DataGrid IsReadOnly="True"
                              SelectionUnit="Cell"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              AutoGenerateColumns="False"
                              PreviewKeyDown="DataGrid_PreviewKeyDown"
                              ui:DataGridHelper.UseModernColumnStyles="True"
                              ItemsSource="{Binding DenominatorDailySchedule}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Selector.IsSelected="False" Header="Урок" Binding="{Binding Lesson.Id}"/>
                            <DataGridTextColumn Header="Понедельник" Binding="{Binding Monday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                            <DataGridTextColumn Header="Вторник" Binding="{Binding Tuesday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                            <DataGridTextColumn Header="Среда" Binding="{Binding Wednesday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                            <DataGridTextColumn Header="Четверг" Binding="{Binding Thursday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                            <DataGridTextColumn Header="Пятница" Binding="{Binding Friday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                            <DataGridTextColumn Header="Суббота" Binding="{Binding Saturday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                            <DataGridTextColumn Header="Воскресенье" Binding="{Binding Sunday.Teacher.Subject, TargetNullValue='&lt;пусто&gt;', FallbackValue='&lt;пусто&gt;'}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </ScrollViewer>

        <ui:ContentDialog IsShadowEnabled="True"
                          PrimaryButtonText="ОК"
                          CloseButtonText="Отмена"
                          x:Name="GroupSelectionDialog"
                          Title="Выберите группу студентов"
                          CloseButtonCommand="{Binding GoBackCommand}"
                          PrimaryButtonCommand="{Binding ContinueCommand}"
                          PrimaryButtonStyle="{DynamicResource AccentButtonStyle}"
                          IsPrimaryButtonEnabled="{Binding SelectedGroup, Converter={StaticResource NullableToBooleanConverter}}">
            <ComboBox ItemsSource="{Binding Groups}"
                      IsSynchronizedWithCurrentItem="True"
                      ui:ControlHelper.Header="Группа студентов"
                      ui:ControlHelper.PlaceholderText="Выберите группу"
                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"/>
        </ui:ContentDialog>

        <ui:FlyoutBase.AttachedFlyout>
            <ui:Flyout x:Name="EditFlyout"
                       Placement="BottomEdgeAlignedRight">
                <Grid Margin="20">
                    <ScrollViewer>
                        <StackPanel ui:PanelHelper.Spacing="8">
                            <ComboBox DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch"
                                      ui:ControlHelper.Header="Предмет"
                                      IsSynchronizedWithCurrentItem="True"
                                      ui:ControlHelper.PlaceholderText="Выберите предмет"
                                      ItemsSource="{Binding Subjects, Mode=TwoWay}"
                                      SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"/>
                            <ComboBox IsEnabled="False"
                                      DisplayMemberPath="FullName"
                                      HorizontalAlignment="Stretch"
                                      IsSynchronizedWithCurrentItem="True"
                                      ui:ControlHelper.Header="Преподаватель"
                                      ui:ControlHelper.PlaceholderText="Выберите преподавателя"
                                      ItemsSource="{Binding Teachers, Mode=TwoWay}"
                                      SelectedItem="{Binding SelectedTeacher, Mode=TwoWay}"/>
                            <ComboBox IsEnabled="False"
                                      DisplayMemberPath="Number"
                                      HorizontalAlignment="Stretch"
                                      ui:ControlHelper.Header="Аудитория"
                                      IsSynchronizedWithCurrentItem="True"
                                      ui:ControlHelper.PlaceholderText="Выберите аудиторию"
                                      ItemsSource="{Binding Classrooms, Mode=TwoWay}"
                                      SelectedItem="{Binding SelectedClassroom, Mode=TwoWay}"/>
                            <TextBlock Foreground="#CC3300"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       Text="{Binding ErrorMessage, Mode=TwoWay}"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                            <Button Content="Сохранить"
                                    HorizontalAlignment="Stretch"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ui:Flyout>
        </ui:FlyoutBase.AttachedFlyout>
    </Grid>
</ui:Page>
