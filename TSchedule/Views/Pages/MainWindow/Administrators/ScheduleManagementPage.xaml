<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.Administrators.ScheduleManagementPage"
         xmlns:c="clr-namespace:TSchedule.Converters"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         d:DesignWidth="800"
         Loaded="Page_Loaded"
         d:Background="White"
         d:DesignHeight="450"
         Title="Управление расписанием"
         PreviewKeyDown="Page_PreviewKeyDown">
    
    <ui:Page.Resources>
        <c:YearBeautifierConverter x:Key="YearBeautifierConverter"/>
        <c:NullableToBooleanConverter x:Key="NullableToBooleanConverter"/>
        <c:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ui:Page.Resources>

    <Grid>
        <StackPanel Margin="6"
                    Panel.ZIndex="1"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    ui:PanelHelper.Spacing="8"
                    HorizontalAlignment="Right">
            <Button Cursor="Hand"
                    CommandParameter="Import"
                    Command="{Binding OpenWizardCommand}">
                <ui:IconAndText FontSize="11"
                                IconSize="11"
                                Content="Импорт"
                                Icon="{x:Static ui:SegoeFluentIcons.Import}"
                                ToolTipService.ToolTip="Импортировать расписание из Excel
                                Горячие клавиши: Ctrl + I"/>
            </Button>
            <Button Cursor="Hand"
                    CommandParameter="Export"
                    Command="{Binding OpenWizardCommand}">
                <ui:IconAndText FontSize="11"
                                IconSize="11"
                                Content="Экспорт"
                                Icon="{x:Static ui:SegoeFluentIcons.Export}"
                                ToolTipService.ToolTip="Экспортировать расписание в Excel
                                Горячие клавиши: Ctrl + E"/>
            </Button>
        </StackPanel>
        
        <ScrollViewer Margin="0,8"
                      HorizontalScrollBarVisibility="Auto">
            <TabControl x:Name="TabControl"
                        ui:TabControlHelper.IsAddTabButtonVisible="False"
                        ui:TabControlHelper.ContentBackground="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
                <!-- Вкладка для числителя -->
                <TabItem IsSelected="True"
                         Header="Числитель"
                         x:Name="NumeratorTab">
                    <DataGrid IsReadOnly="True"
                              MinRowHeight="32"
                              MinColumnWidth="20"
                              CellStyle="{x:Null}"
                              SelectionUnit="Cell"
                              x:Name="NumeratorGrid"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              GridLinesVisibility="All"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              CanUserSortColumns="False"
                              AutoGenerateColumns="False"
                              ItemsSource="{Binding NumeratorDailySchedule}"
                              ui:DataGridHelper.UseModernColumnStyles="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="CopyMenuItem_Click"
                                          InputGestureText="Ctrl + C">
                                    <MenuItem.Header>
                                        <ui:IconAndText Content="Скопировать"
                                                        HorizontalAlignment="Stretch"
                                                        Icon="{x:Static ui:SegoeFluentIcons.Copy}"/>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Click="PasteMenuItem_Click"
                                          InputGestureText="Ctrl + V">
                                    <MenuItem.Header>
                                        <ui:IconAndText Content="Вставить"
                                                        HorizontalAlignment="Stretch"
                                                        Icon="{x:Static ui:SegoeFluentIcons.Paste}"/>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem InputGestureText="Insert"
                                          Click="EditMenuItem_Click">
                                    <MenuItem.Header>
                                        <ui:IconAndText Content="Изменить"
                                                        HorizontalAlignment="Stretch"
                                                        Icon="{x:Static ui:SegoeFluentIcons.Edit}"/>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem InputGestureText="Delete"
                                          Click="DeleteMenuItem_Click">
                                    <MenuItem.Header>
                                        <ui:IconAndText Content="Удалить"
                                                        Foreground="#CC3300"
                                                        HorizontalAlignment="Stretch"
                                                        Icon="{x:Static ui:SegoeFluentIcons.Delete}"/>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Selector.IsSelected="False" Header="Урок" Binding="{Binding Lesson.Id}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="6"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Понедельник" Binding="{Binding Monday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Monday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Вторник" Binding="{Binding Tuesday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Tuesday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Среда" Binding="{Binding Wednesday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Wednesday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Четверг" Binding="{Binding Thursday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Thursday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Пятница" Binding="{Binding Friday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Friday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Суббота" Binding="{Binding Saturday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Saturday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Воскресенье" Binding="{Binding Sunday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Sunday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Вкладка для знаменателя -->
                <TabItem Header="Знаменатель"
                         x:Name="DenominatorTab">
                    <DataGrid IsReadOnly="True"
                              MinRowHeight="32"
                              MinColumnWidth="20"
                              CellStyle="{x:Null}"
                              SelectionUnit="Cell"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              x:Name="DenominatorGrid"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              CanUserSortColumns="False"
                              AutoGenerateColumns="False"
                              ui:DataGridHelper.UseModernColumnStyles="True"
                              ItemsSource="{Binding DenominatorDailySchedule}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem InputGestureText="Ctrl + C"
                                          Click="CopyMenuItem_Click">
                                    <MenuItem.Header>
                                        <ui:IconAndText Content="Скопировать"
                                                        HorizontalAlignment="Stretch"
                                                        Icon="{x:Static ui:SegoeFluentIcons.Copy}"/>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem InputGestureText="Ctrl + V"
                                          Click="PasteMenuItem_Click">
                                    <MenuItem.Header>
                                        <ui:IconAndText Content="Вставить"
                                                        HorizontalAlignment="Stretch"
                                                        Icon="{x:Static ui:SegoeFluentIcons.Paste}"/>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem InputGestureText="Insert"
                                          Click="EditMenuItem_Click">
                                    <MenuItem.Header>
                                        <ui:IconAndText Content="Изменить"
                                                        HorizontalAlignment="Stretch"
                                                        Icon="{x:Static ui:SegoeFluentIcons.Edit}"/>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem InputGestureText="Delete"
                                          Click="DeleteMenuItem_Click">
                                    <MenuItem.Header>
                                        <ui:IconAndText Content="Удалить"
                                                        Foreground="#CC3300"
                                                        HorizontalAlignment="Stretch"
                                                        Icon="{x:Static ui:SegoeFluentIcons.Delete}"/>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Selector.IsSelected="False" Header="Урок" Binding="{Binding Lesson.Id}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="6"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Понедельник" Binding="{Binding Monday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Monday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Вторник" Binding="{Binding Tuesday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Tuesday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Среда" Binding="{Binding Wednesday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Wednesday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Четверг" Binding="{Binding Thursday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Thursday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Пятница" Binding="{Binding Friday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Friday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Суббота" Binding="{Binding Saturday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Saturday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Воскресенье" Binding="{Binding Sunday.Teacher.Subject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ToolTip" Value="{Binding Sunday.Teacher.Subject, TargetNullValue='Пусто', FallbackValue='Пусто'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </ScrollViewer>

        <ui:ContentDialog d:Panel.ZIndex="2"
                          IsShadowEnabled="True"
                          CloseButtonText="Отмена"
                          PrimaryButtonText="Далее"
                          x:Name="GroupSelectionDialog"
                          Title="Выберите группу студентов"
                          CloseButtonCommand="{Binding GoBackCommand}"
                          PrimaryButtonCommand="{Binding ContinueCommand}"
                          PrimaryButtonStyle="{DynamicResource AccentButtonStyle}"
                          IsPrimaryButtonEnabled="{Binding SelectedGroup, Converter={StaticResource NullableToBooleanConverter}}">
            <StackPanel ui:PanelHelper.Spacing="8">
                <ComboBox ItemsSource="{Binding Years}"
                          HorizontalAlignment="Stretch"
                          ui:ControlHelper.Header="Год"
                          IsSynchronizedWithCurrentItem="True"
                          ui:ControlHelper.PlaceholderText="Выберите год"
                          SelectedItem="{Binding Year, Mode=TwoWay, Converter={StaticResource YearBeautifierConverter}}"/>
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Semesters}"
                          ui:ControlHelper.Header="Семестр"
                          IsSynchronizedWithCurrentItem="True"
                          SelectedItem="{Binding Semester, Mode=TwoWay}"
                          ui:ControlHelper.PlaceholderText="Выберите семестр"/>
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Groups}"
                          IsSynchronizedWithCurrentItem="True"
                          ui:ControlHelper.Header="Группа студентов"
                          ui:ControlHelper.PlaceholderText="Выберите группу"
                          SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"/>
            </StackPanel>
        </ui:ContentDialog>

        <ui:FlyoutBase.AttachedFlyout>
            <ui:Flyout x:Name="EditFlyout"
                       Placement="BottomEdgeAlignedRight">
                <Grid Margin="20">
                    <ScrollViewer>
                        <StackPanel ui:PanelHelper.Spacing="8">
                            <ComboBox DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch"
                                      ui:ControlHelper.Header="Предмет"
                                      IsSynchronizedWithCurrentItem="True"
                                      ui:ControlHelper.PlaceholderText="Выберите предмет"
                                      ItemsSource="{Binding Subjects, Mode=TwoWay}"
                                      SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"/>
                            <ComboBox IsEnabled="False"
                                      DisplayMemberPath="FullName"
                                      HorizontalAlignment="Stretch"
                                      IsSynchronizedWithCurrentItem="True"
                                      ui:ControlHelper.Header="Преподаватель"
                                      ui:ControlHelper.PlaceholderText="Выберите преподавателя"
                                      ItemsSource="{Binding Teachers, Mode=TwoWay}"
                                      SelectedItem="{Binding SelectedTeacher, Mode=TwoWay}"/>
                            <ComboBox IsEnabled="False"
                                      DisplayMemberPath="Number"
                                      HorizontalAlignment="Stretch"
                                      ui:ControlHelper.Header="Аудитория"
                                      IsSynchronizedWithCurrentItem="True"
                                      ui:ControlHelper.PlaceholderText="Выберите аудиторию"
                                      ItemsSource="{Binding Classrooms, Mode=TwoWay}"
                                      SelectedItem="{Binding SelectedClassroom, Mode=TwoWay}"/>
                            <TextBlock Foreground="#CC3300"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       Text="{Binding ErrorMessage, Mode=TwoWay}"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                            <Button Cursor="Hand"
                                    Content="Сохранить"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding SaveCommand}"
                                    Style="{DynamicResource AccentButtonStyle}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ui:Flyout>
        </ui:FlyoutBase.AttachedFlyout>
    </Grid>
</ui:Page>
