<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.Administrators.ScheduleManagementPage"
         xmlns:c="clr-namespace:TSchedule.Converters"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         d:DesignWidth="800"
         Loaded="Page_Loaded"
         d:Background="White"
         d:DesignHeight="450"
         Title="Управление расписанием"
         WindowTitle="TSchedule. Управление расписанием">
    
    <ui:Page.Resources>
        <c:StringToInitialsConverter x:Key="StringToInitialsConverter"/>
        <c:NullableToBooleanConverter x:Key="NullableToBooleanConverter"/>
        <c:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ui:Page.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto">

            <TabControl x:Name="TabControl"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        ui:TabControlHelper.IsAddTabButtonVisible="False"
                        ui:TabControlHelper.ContentBackground="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
                
                <ui:FlyoutBase.AttachedFlyout>
                    <ui:Flyout x:Name="EditFlyout"
                               ShowMode="Transient"
                               Placement="RightEdgeAlignedTop">
                        <StackPanel Width="300"
                                    Margin="10"
                                    x:Name="FormPanel"
                                    ui:PanelHelper.Spacing="8">
                            <TextBlock FontSize="16"
                                       FontWeight="Bold"
                                       Text="Редактирование занятия"/>
                            <ComboBox DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Subjects}"
                                      ui:ControlHelper.Header="Предмет"
                                      ui:ControlHelper.PlaceholderText="Выберите предмет"
                                      ui:ComboBoxHelper.KeepInteriorCornersSquare="False"
                                      SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"/>
                            <ComboBox DisplayMemberPath="FullName"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Teachers}"
                                      ui:ControlHelper.Header="Преподаватель"
                                      ui:ComboBoxHelper.KeepInteriorCornersSquare="False"
                                      ui:ControlHelper.PlaceholderText="Выберите преподавателя"
                                      SelectedItem="{Binding SelectedTeacher, Mode=TwoWay}"/>
                            <ComboBox DisplayMemberPath="Number"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Classrooms}"
                                      ui:ControlHelper.Header="Аудитория"
                                      ui:ComboBoxHelper.KeepInteriorCornersSquare="False"
                                      ui:ControlHelper.PlaceholderText="Выберите аудиторию"
                                      SelectedItem="{Binding SelectedClassroom, Mode=TwoWay}"/>
                            <TextBlock MaxWidth="240"
                                       TextWrapping="Wrap"
                                       Foreground="#CC3300"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       Text="{Binding ErrorMessage, Mode=TwoWay}"
                                       Visibility="{Binding ErrorMessage, Mode=TwoWay, Converter={StaticResource StringToVisibilityConverter}}"/>
                            <Button Content="Сохранить"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding SaveCommand}"
                                    Style="{DynamicResource AccentButtonStyle}"/>
                        </StackPanel>
                    </ui:Flyout>
                </ui:FlyoutBase.AttachedFlyout>

                <!-- Вкладка для числителя -->
                <TabItem IsSelected="True"
                            Header="Числитель">
                    <DataGrid IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              HeadersVisibility="All"
                              AutoGenerateColumns="False"
                              ui:ControlHelper.CornerRadius="8"
                              ItemsSource="{Binding NumeratorSchedule}"
                              ui:DataGridHelper.UseModernColumnStyles="True"
                              SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ занятия"
                                                Binding="{Binding LessonNumber}"/>
                            <DataGridTemplateColumn Header="Понедельник">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="ПН;0"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Вторник">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="ВТ;0"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Среда">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="СР;0"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Четверг">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="ЧТ;0"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Пятница">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="ПТ;0"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Суббота">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="СБ;0"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Воскресенье">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="ВС;0"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Вкладка для знаменателя -->
                <TabItem Header="Знаменатель">
                    <DataGrid IsReadOnly="True"
                                SelectionMode="Single"
                                CanUserAddRows="False"
                                HeadersVisibility="All"
                                AutoGenerateColumns="False"
                                ui:ControlHelper.CornerRadius="8"
                                ItemsSource="{Binding DenominatorSchedule}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ занятия"
                                                Binding="{Binding LessonNumber}"/>
                            <!-- Аналогичная структура столбцов для расписания знаменателя -->
                            <DataGridTemplateColumn Header="Понедельник">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="ПН;1"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Вторник">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="ВТ;1"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Среда">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="СР;1"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Четверг">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="ЧТ;1"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Пятница">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="ПТ;1"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Суббота">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="СБ;1"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Воскресенье">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                                            CommandParameter="ВС;1"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{Binding Subject.Name, FallbackValue='&lt;null>'}"
                                                            Command="{Binding DataContext.ShowFlyoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </ScrollViewer>
    </Grid>
</ui:Page>
