<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.Administrators.SubjectsManagementPage"
         xmlns:c="clr-namespace:TSchedule.Converters"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d" 
         d:DesignWidth="800"
         Loaded="Page_Loaded"
         d:DesignHeight="450"
         d:Background="White"
         Title="Управление предметами">

    <ui:Page.Resources>
        <c:ValueToOpacityConverter x:Key="ValueToOpacityConverter"/>
        <c:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ui:Page.Resources>

    <Grid Margin="20"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <ui:FlyoutBase.AttachedFlyout>
            <ui:Flyout x:Name="SubjectsFlyout">
                <Border Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <ScrollViewer Grid.Row="0"
                                          ui:ScrollViewerBehavior.IsAnimating="True">
                                <StackPanel ui:PanelHelper.Spacing="16">
                                    <TextBox Width="240"
                                             MaxLength="50"
                                             Text="{Binding SubjectCode}"
                                             ui:ControlHelper.Header="Код"
                                             ui:ControlHelper.CornerRadius="8"
                                             ui:ControlHelper.PlaceholderText="МДК 01.03"
                                             ui:TextBoxHelper.IsDeleteButtonVisible="True"
                                             ui:TextContextMenu.UsingTextContextMenu="True"/>
                                    <TextBox Width="240"
                                             MaxLength="50"
                                             Text="{Binding SubjectName}"
                                             ui:ControlHelper.CornerRadius="8"
                                             ui:ControlHelper.Header="Наименование"
                                             ui:ControlHelper.PlaceholderText="Веб-дизайн"
                                             ui:TextBoxHelper.IsDeleteButtonVisible="True"
                                             ui:TextContextMenu.UsingTextContextMenu="True"/>
                                    <ComboBox Width="240"
                                              ui:ControlHelper.CornerRadius="8"
                                              IsSynchronizedWithCurrentItem="True"
                                              ui:ControlHelper.Header="Специальность"
                                              ui:ControlHelper.PlaceholderText="Для какой специальности"
                                              SelectedItem="{Binding Specialty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                              ItemsSource="{Binding Specialties}"/>
                                    <ui:NumberBox Width="240"
                                                  Minimum="1"
                                                  Maximum="1000"
                                                  ui:ControlHelper.CornerRadius="8"
                                                  Text="{Binding SubjectWeeklyHours}"
                                                  ui:ControlHelper.Header="Часы на неделю"
                                                  ui:TextContextMenu.UsingTextContextMenu="True"
                                                  ui:ControlHelper.PlaceholderText="Введите, сколько часов в неделю"/>
                                    <TextBlock MaxWidth="240"
                                               TextWrapping="Wrap"
                                               Foreground="#CC3300"
                                               TextAlignment="Center"
                                               Text="{Binding ErrorMessage}"
                                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Margin="0,16,0,0"
                                    ui:PanelHelper.Spacing="8">
                            <Button Content="Сохранить"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding AddOrEditCommand}"
                                    Style="{DynamicResource AccentButtonStyle}"/>
                            <Button Content="Отмена"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding HideFlyoutCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </ui:Flyout>
        </ui:FlyoutBase.AttachedFlyout>

        <ui:ListView Padding="4"
                     Grid.Column="0"
                     x:Name="SubjectsList"
                     SelectionMode="Single"
                     ItemsSource="{Binding Subjects}"
                     SelectedItem="{Binding Subject}">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4"
                            CornerRadius="8"
                            BorderThickness="1">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="20,0"
                                        Grid.Column="1"
                                        ui:PanelHelper.Spacing="4">
                                <TextBlock FontSize="16"
                                           FontWeight="Bold"
                                           Text="{Binding Name}"/>
                                
                                <TextBlock FontSize="12"
                                           Text="{Binding Code}"/>
                                
                                <TextBlock FontSize="12"
                                           Text="{Binding Specialty.Name}"/>
                                
                                <TextBlock FontSize="12"
                                           Text="{Binding SemesterHours, StringFormat={}{0} ч.}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>

        <StackPanel Margin="8"
                    Grid.Column="1"
                    ui:PanelHelper.Spacing="8"
                    HorizontalAlignment="Stretch">

            <Button x:Name="AddButton"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ShowFlyoutCommand}"
                    Style="{DynamicResource AccentButtonStyle}">
                <ui:IconAndText Content="Добавить"
                                Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
            </Button>

            <Button x:Name="EditButton"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ShowEditFlyoutCommand}">
                <ui:IconAndText Content="Изменить"
                                Icon="{x:Static ui:SegoeFluentIcons.Edit}"/>
            </Button>

            <Button x:Name="DeleteButton"
                    Foreground="#CC3300"
                    HorizontalAlignment="Stretch"
                    Command="{Binding DeleteCommand}">
                <ui:IconAndText Content="Удалить"
                                Icon="{x:Static ui:SegoeFluentIcons.Delete}"/>
            </Button>
        </StackPanel>
    </Grid>

</ui:Page>
