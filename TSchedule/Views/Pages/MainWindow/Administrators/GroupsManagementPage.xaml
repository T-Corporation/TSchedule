<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.Administrators.GroupsManagementPage"
         xmlns:c="clr-namespace:TSchedule.Converters"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         d:DesignWidth="800"
         Loaded="Page_Loaded"
         d:Background="White"
         d:DesignHeight="450"
         Title="Управление группами">

    <ui:Page.Resources>
        <c:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ui:Page.Resources>

    <Grid Margin="20"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <ui:FlyoutBase.AttachedFlyout>
            <ui:Flyout x:Name="GroupsFlyout">
                <Border Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <ScrollViewer Grid.Row="0"
                                          ui:ScrollViewerBehavior.IsAnimating="True">
                                <StackPanel ui:PanelHelper.Spacing="16">
                                    <TextBox Width="240"
                                             MaxLength="50"
                                             Text="{Binding GroupCode}"
                                             ui:ControlHelper.Header="Код"
                                             ui:ControlHelper.CornerRadius="8"
                                             ui:ControlHelper.PlaceholderText="ИС-2"
                                             ui:TextBoxHelper.IsDeleteButtonVisible="True"
                                             ui:TextContextMenu.UsingTextContextMenu="True"/>
                                    <ui:NumberBox Width="240"
                                                  Minimum="1"
                                                  Maximum="5"
                                                  Text="{Binding GroupCourse}"
                                                  ui:ControlHelper.Header="Курс"
                                                  ui:ControlHelper.CornerRadius="8"
                                                  ui:ControlHelper.PlaceholderText="Веб-дизайн"
                                                  ui:TextContextMenu.UsingTextContextMenu="True"/>
                                    <ComboBox Width="240"
                                              ui:ControlHelper.CornerRadius="8"
                                              SelectedItem="{Binding Specialty}"
                                              ItemsSource="{Binding Specialties}"
                                              ToolTipService.HasDropShadow="True"
                                              IsSynchronizedWithCurrentItem="True"
                                              ui:ControlHelper.Header="Специальность"
                                              ui:ControlHelper.PlaceholderText="Дизайн"
                                              ToolTipService.ToolTip="{Binding Specialty}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Padding="2"
                                                           Text="{Binding}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel ui:PanelHelper.Spacing="8">
                                        <TextBlock Text="Предметы"
                                                   Padding="0,0,0,4"/>
                                        <ui:ListView MaxHeight="180"
                                                     IsSelectionEnabled="False"
                                                     IsItemClickEnabled="False"
                                                     ui:ControlHelper.Header="Предметы"
                                                     ItemsSource="{Binding SelectedSubjects}">
                                            <ui:ListView.ItemContainerStyle>
                                                <Style TargetType="ui:ListViewItem">
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="Width" Value="280"/>
                                                    <Setter Property="Padding" Value="4"/>
                                                    <Setter Property="ui:ControlHelper.CornerRadius" Value="8"/>
                                                </Style>
                                            </ui:ListView.ItemContainerStyle>
                                            <ui:ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ui:PanelHelper.Spacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="92"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                                                        <ComboBox MinWidth="80"
                                                                  MaxWidth="200"
                                                                  Grid.Column="0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Stretch"
                                                                  ToolTipService.HasDropShadow="True"
                                                                  SelectedItem="{Binding SelectedSubject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  ToolTipService.ToolTip="{Binding SelectedSubject.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  ItemsSource="{Binding DataContext.Subjects, RelativeSource={RelativeSource AncestorType=ui:Page}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Padding="4"
                                                                               Text="{Binding Name}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <Button Grid.Column="1"
                                                                Content="Удалить"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Stretch"
                                                                Command="{Binding DataContext.DeleteSubjectCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ui:ListView.ItemTemplate>
                                        </ui:ListView>

                                        <Button Width="92"
                                                Margin="0,0,8,0"
                                                Content="Добавить"
                                                HorizontalAlignment="Right"
                                                Command="{Binding AddSubjectCommand}"/>
                                    </StackPanel>

                                    <TextBlock MaxWidth="240"
                                               TextWrapping="Wrap"
                                               Foreground="#CC3300"
                                               TextAlignment="Center"
                                               Text="{Binding ErrorMessage}"
                                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        
                        <StackPanel Grid.Row="1"
                                    Margin="0,16,0,0"
                                    ui:PanelHelper.Spacing="8">
                            <Button Cursor="Hand"
                                    Content="Сохранить"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding AddOrEditCommand}"
                                    Style="{DynamicResource AccentButtonStyle}"/>
                            <Button Cursor="Hand"
                                    Content="Отмена"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding HideFlyoutCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </ui:Flyout>
        </ui:FlyoutBase.AttachedFlyout>

        <ui:ListView Padding="4"
                     Grid.Column="0"
                     x:Name="GroupsList"
                     SelectionMode="Single"
                     ItemsSource="{Binding Groups}"
                     SelectedItem="{Binding Group}">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4"
                            CornerRadius="8"
                            BorderThickness="1">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="20,0"
                                        Grid.Column="1"
                                        ui:PanelHelper.Spacing="4">
                                <TextBlock FontSize="16"
                                           FontWeight="Bold"
                                           Text="{Binding Code}"/>

                                <TextBlock FontSize="12"
                                           Text="{Binding Specialty}"/>

                                <TextBlock FontSize="12"
                                           Text="{Binding Course, StringFormat='Курс {0}'}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>

        <StackPanel Margin="8"
                    Grid.Column="1"
                    ui:PanelHelper.Spacing="8"
                    HorizontalAlignment="Stretch">

            <Button Cursor="Hand"
                    x:Name="AddButton"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ShowFlyoutCommand}"
                    Style="{DynamicResource AccentButtonStyle}">
                <ui:IconAndText Content="Добавить"
                                Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
            </Button>

            <Button Cursor="Hand"
                    x:Name="EditButton"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ShowEditFlyoutCommand}">
                <ui:IconAndText Content="Изменить"
                                Icon="{x:Static ui:SegoeFluentIcons.Edit}"/>
            </Button>

            <Button Cursor="Hand"
                    x:Name="DeleteButton"
                    Foreground="#CC3300"
                    HorizontalAlignment="Stretch"
                    Command="{Binding DeleteCommand}">
                <ui:IconAndText Content="Удалить"
                                Icon="{x:Static ui:SegoeFluentIcons.Delete}"/>
            </Button>
        </StackPanel>
    </Grid>

</ui:Page>
