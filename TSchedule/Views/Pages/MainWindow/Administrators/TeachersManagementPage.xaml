<ui:Page x:Class="TSchedule.Views.Pages.MainWindow.Administrators.TeachersManagementPage"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         d:DesignWidth="800"
         Loaded="Page_Loaded"
         d:DesignHeight="450"
         Title="Управление преподавателями">

    <Grid Margin="20"
          VerticalAlignment="Top"
          HorizontalAlignment="Stretch">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        
        <ui:ListView Margin="4"
                     Grid.Column="0"
                     SelectionMode="Single"
                     ItemsSource="{Binding Teachers}"
                     SelectedItem="{Binding Teacher}">
            
            <ui:ListView.ItemTemplate>

                <DataTemplate>
                    <StackPanel>
                        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                        <TextBlock Padding="2"
                                   Text="{Binding FullName}"/>
                        <TextBlock Padding="2"
                                   Text="{Binding UserName, StringFormat='@{0}'}"/>
                        <TextBlock Padding="2"
                                   Text="{Binding Email}"/>
                        <TextBlock Padding="2"
                                   Text="{Binding Phone}"/>
                    </StackPanel>
                </DataTemplate>

            </ui:ListView.ItemTemplate>
            
        </ui:ListView>
        
        <StackPanel Margin="8"
                    Grid.Column="1"
                    ui:PanelHelper.Spacing="16"
                    HorizontalAlignment="Stretch">

            <Button HorizontalAlignment="Stretch">
                <ui:IconAndText Padding="8"
                                Content="Добавить"
                                Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
            </Button>
            
            <Button Foreground="#33BBBB"
                    HorizontalAlignment="Stretch">
                <ui:IconAndText Content="Изменить"
                                Icon="{x:Static ui:SegoeFluentIcons.Edit}"/>
            </Button>
            
            <Button Foreground="#CC3300"
                    HorizontalAlignment="Stretch">
                <ui:IconAndText Content="Удалить"
                                Icon="{x:Static ui:SegoeFluentIcons.Delete}"/>
            </Button>

        </StackPanel>
        
    </Grid>
    
</ui:Page>
